# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realtime_game?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Game
GAME_TICK_RATE=20
MAX_PLAYERS_PER_ROOM=8
MAX_MOVE_SPEED=12
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
WS_RATE_LIMIT_PER_SECOND=30

# Auth
BCRYPT_ROUNDS=12
HTTP_RATE_LIMIT_MAX=1000
HTTP_RATE_LIMIT_WINDOW=1 minute

# Admin (required for /admin/* privileged mutations)
# Leave unset to keep grant/credit endpoints disabled.
ADMIN_API_KEY=dev-admin-key-change-me
