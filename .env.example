# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-postgres-password
POSTGRES_DB=realtime_game
DATABASE_URL=postgresql://postgres:local-dev-postgres-password@localhost:5432/realtime_game?schema=public

# Redis
REDIS_PASSWORD=local-dev-redis-password
REDIS_URL=redis://:local-dev-redis-password@localhost:6379

# JWT — use long random values. Production rejects secrets containing
# placeholders like "change-me", "dev-access", or "production-access".
JWT_ACCESS_SECRET=9f3c2a1b8e7d6c5b4a3928170695f4e3d2c1b0a9876543210fedcba
JWT_REFRESH_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Game
GAME_TICK_RATE=20
MAX_PLAYERS_PER_ROOM=8
MAX_MOVE_SPEED=12
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
WS_RATE_LIMIT_PER_SECOND=30
WS_CONNECT_RATE_LIMIT_PER_MINUTE=60

# Auth / HTTP
BCRYPT_ROUNDS=12
HTTP_RATE_LIMIT_MAX=300
HTTP_RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=1 minute

# Admin (optional; required only to unlock /admin/*)
ADMIN_API_KEY=localadmin-key-16chars

# CORS allowlist (comma-separated). Use * only for local experimentation.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
